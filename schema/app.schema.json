{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "localctl app config",
  "type": "object",
  "required": [
    "name",
    "port",
    "build"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "description": "Lowercase alphanumeric + dashes. Used as Deployment/Service name and Docker image name.",
      "maxLength": 63
    },
    "subdomain": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "description": "Defaults to name. App is reachable at <subdomain>.local.test",
      "maxLength": 63
    },
    "namespace": {
      "type": "string",
      "description": "Defaults to name. Not default, kube-system, kube-public, kube-node-lease or observability. An existing namespace that localctl did not create is refused.",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "maxLength": 63
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "description": "Port the app listens on inside the container."
    },
    "build": {
      "type": "object",
      "properties": {
        "context": {
          "default": ".",
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^(?![\\\\/~]|[A-Za-z]:)[^\\u0000-\\u001f\\u007f]*$",
          "description": "Relative path inside the git repository (no absolute path, no ~, no control characters)."
        },
        "dockerfile": {
          "default": "Dockerfile",
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^(?![\\\\/~]|[A-Za-z]:)[^\\u0000-\\u001f\\u007f]*$",
          "description": "Relative path inside the git repository (no absolute path, no ~, no control characters)."
        },
        "target": {
          "type": "string",
          "description": "Multi-stage build target (docker build --target).",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "description": "Build arguments (docker build --build-arg KEY=value).",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "maxProperties": 100
        },
        "ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths left out of the build context and not watched by Tilt.",
          "maxItems": 100
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
        "maxLength": 253
      },
      "maxProperties": 200
    },
    "secrets": {
      "type": "array",
      "description": "Names only - values are never stored here. Set with \"localctl app secrets set <KEY>\"; injected via secretKeyRef, same as an addon's credentials. A name can't also appear in \"env\".",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "maxItems": 100
    },
    "replicas": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "maximum": 20
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ],
              "pattern": "^[0-9]{1,7}(\\.[0-9]{1,3})?m?$",
              "description": "500m, 1 or 0.5 (max 1024 cores)."
            },
            "memory": {
              "type": [
                "string",
                "number"
              ],
              "pattern": "^[0-9]{1,13}(\\.[0-9]{1,3})?(k|Ki|Mi|Gi|Ti|M|G|T)?$",
              "description": "256Mi, 2Gi or 1G (max 1 TiB). No milli suffix."
            }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ],
              "pattern": "^[0-9]{1,7}(\\.[0-9]{1,3})?m?$",
              "description": "500m, 1 or 0.5 (max 1024 cores)."
            },
            "memory": {
              "type": [
                "string",
                "number"
              ],
              "pattern": "^[0-9]{1,13}(\\.[0-9]{1,3})?(k|Ki|Mi|Gi|Ti|M|G|T)?$",
              "description": "256Mi, 2Gi or 1G (max 1 TiB). No milli suffix."
            }
          }
        }
      },
      "description": "A request cannot exceed its limit."
    },
    "debug": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "type": {
          "type": "string",
          "enum": [
            "node",
            "python",
            "go",
            "java",
            "dotnet"
          ]
        }
      }
    },
    "probes": {
      "type": "object",
      "description": "Defaults to a plain TCP check on \"port\" for both if omitted entirely. Set \"path\" to use an HTTP GET check instead.",
      "properties": {
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9._~/-]*$"
            },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "description": "Exec probe: healthy when it exits 0. Use instead of path."
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9._~/-]*$"
            },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "description": "Exec probe: healthy when it exits 0. Use instead of path."
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        },
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9._~/-]*$"
            },
            "command": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "description": "Exec probe: healthy when it exits 0. Use instead of path."
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "postgres",
              "redis",
              "mongo"
            ]
          },
          "version": {
            "type": [
              "string",
              "number"
            ],
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
          },
          "database": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "storage": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?(Mi|Gi|Ti)$",
            "description": "e.g. 1Gi"
          },
          "resources": {
            "type": "object",
            "properties": {
              "requests": {
                "type": "object",
                "properties": {
                  "cpu": {
                    "type": [
                      "string",
                      "number"
                    ],
                    "pattern": "^[0-9]{1,7}(\\.[0-9]{1,3})?m?$",
                    "description": "500m, 1 or 0.5 (max 1024 cores)."
                  },
                  "memory": {
                    "type": [
                      "string",
                      "number"
                    ],
                    "pattern": "^[0-9]{1,13}(\\.[0-9]{1,3})?(k|Ki|Mi|Gi|Ti|M|G|T)?$",
                    "description": "256Mi, 2Gi or 1G (max 1 TiB). No milli suffix."
                  }
                }
              },
              "limits": {
                "type": "object",
                "properties": {
                  "cpu": {
                    "type": [
                      "string",
                      "number"
                    ],
                    "pattern": "^[0-9]{1,7}(\\.[0-9]{1,3})?m?$",
                    "description": "500m, 1 or 0.5 (max 1024 cores)."
                  },
                  "memory": {
                    "type": [
                      "string",
                      "number"
                    ],
                    "pattern": "^[0-9]{1,13}(\\.[0-9]{1,3})?(k|Ki|Mi|Gi|Ti|M|G|T)?$",
                    "description": "256Mi, 2Gi or 1G (max 1 TiB). No milli suffix."
                  }
                }
              }
            },
            "description": "CPU/memory for the dependency pod. The addon must declare resourcesPath."
          }
        }
      },
      "maxItems": 10,
      "description": "Each type at most once per app; name + \"-\" + type must be at most 53 characters (Helm limit)."
    },
    "sidecars": {
      "type": "array",
      "description": "Extra containers in the same pod as your app (the k8s sidecar pattern) - reachable from your app via localhost:<port>, no Service needed.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "image"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
          },
          "image": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][^\\s\\u0000-\\u001f\\u007f]*$"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "maxLength": 253
            },
            "maxProperties": 200
          }
        }
      },
      "maxItems": 10
    },
    "sync": {
      "type": "array",
      "description": "Paths live-synced into the running container by Tilt without a full rebuild.",
      "items": {
        "type": "object",
        "required": [
          "localPath",
          "remotePath"
        ],
        "properties": {
          "localPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "^(?![\\\\/~]|[A-Za-z]:)[^\\u0000-\\u001f\\u007f]*$",
            "description": "Relative path inside the git repository (no absolute path, no ~, no control characters)."
          },
          "remotePath": {
            "type": "string"
          }
        }
      },
      "maxItems": 50
    },
    "tls": {
      "type": "boolean",
      "default": true
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Overrides the image ENTRYPOINT for the main container.",
      "maxItems": 100
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Overrides the image CMD for the main container.",
      "maxItems": 100
    },
    "run": {
      "type": "array",
      "description": "Commands run in the container after files are synced. Needs at least one sync entry.",
      "items": {
        "type": "object",
        "required": [
          "command"
        ],
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string"
          },
          "trigger": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Only run when one of these paths changed."
          }
        }
      },
      "maxItems": 50
    },
    "envFile": {
      "type": "string",
      "description": "Dotenv-style file (KEY=value) inside the app folder, merged into env. Keys in env win."
    },
    "ports": {
      "type": "array",
      "description": "Extra container ports (also on the in-cluster Service).",
      "items": {
        "type": "object",
        "required": [
          "port"
        ],
        "additionalProperties": false,
        "properties": {
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z]([a-z0-9-]{0,13}[a-z0-9])?$"
          },
          "protocol": {
            "enum": [
              "TCP",
              "UDP"
            ],
            "default": "TCP"
          },
          "forward": {
            "type": "boolean",
            "default": false,
            "description": "Also forward this port to localhost."
          }
        }
      },
      "maxItems": 20
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "description": "Extra ingress settings.",
      "properties": {
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
          },
          "description": "More subdomains of local.test routed to this app.",
          "maxItems": 20
        },
        "paths": {
          "type": "array",
          "description": "Replaces the default / route.",
          "items": {
            "type": "object",
            "required": [
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^/[A-Za-z0-9._~/-]*$",
                "description": "No //, .. or percent escapes."
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535,
                "description": "Must be \"port\" or a TCP entry of \"ports\"."
              }
            }
          },
          "maxItems": 50
        },
        "annotations": {
          "type": "object",
          "description": "Allowed keys: traefik.ingress.kubernetes.io/service.passhostheader, traefik.ingress.kubernetes.io/service.sticky.cookie, traefik.ingress.kubernetes.io/service.sticky.cookie.name, traefik.ingress.kubernetes.io/service.sticky.cookie.secure, traefik.ingress.kubernetes.io/service.serversscheme.",
          "propertyNames": {
            "enum": [
              "traefik.ingress.kubernetes.io/service.passhostheader",
              "traefik.ingress.kubernetes.io/service.sticky.cookie",
              "traefik.ingress.kubernetes.io/service.sticky.cookie.name",
              "traefik.ingress.kubernetes.io/service.sticky.cookie.secure",
              "traefik.ingress.kubernetes.io/service.serversscheme"
            ]
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "volumes": {
      "type": "array",
      "description": "Scratch space (emptyDir) mounted into the app. Gone when the pod is.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "mountPath"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
          },
          "mountPath": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9._/-]*$",
            "description": "Absolute path in plain form (no //, /./, .., trailing /). Not under /proc, /sys, /dev or /var/run/secrets."
          },
          "sizeLimit": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?(Mi|Gi|Ti)$"
          }
        }
      },
      "maxItems": 20
    },
    "initContainers": {
      "type": "array",
      "description": "Run to completion before the app starts (migrations, seeding). Uses the app image unless image is set.",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
          },
          "image": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][^\\s\\u0000-\\u001f\\u007f]*$"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "maxLength": 253
            },
            "maxProperties": 200
          }
        }
      },
      "maxItems": 10
    },
    "labels": {
      "type": "object",
      "description": "Extra labels. app and localctl.dev/* are reserved.",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "maxProperties": 50
    },
    "annotations": {
      "type": "object",
      "description": "Extra pod annotations: a plain key (note, team) or under prometheus.io/, reloader.stakater.com/, fluentbit.io/, ad.datadoghq.com/, co.elastic.logs/, logging.banzaicloud.io/, backup.velero.io/ or checksum/.",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "maxProperties": 50,
      "propertyNames": {
        "pattern": "^(?:[A-Za-z0-9_-]+|(?:prometheus\\.io|reloader\\.stakater\\.com|fluentbit\\.io|ad\\.datadoghq\\.com|co\\.elastic\\.logs|logging\\.banzaicloud\\.io|backup\\.velero\\.io|checksum)/[A-Za-z0-9][A-Za-z0-9._-]*)$"
      }
    },
    "imagePullPolicy": {
      "enum": [
        "Always",
        "IfNotPresent",
        "Never"
      ]
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "description": "Settings that tighten the container only.",
      "properties": {
        "runAsUser": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "allowPrivilegeEscalation": {
          "const": false,
          "description": "Can only be turned off."
        }
      }
    },
    "environments": {
      "type": "object",
      "description": "Named overrides merged over this file with: localctl app up --env <name>. Objects merge, lists replace. name, namespace, envFile and environments cannot be overridden.",
      "propertyNames": {
        "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
