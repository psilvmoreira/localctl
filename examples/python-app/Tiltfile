# Generated by `localctl app new`.
# Most configuration lives in .local/config.json - edit that instead of this file
# unless you need custom Tilt behavior (extra resources, manual k8s_yaml, etc).

config_json = read_json('.local/config.json')

# Images are built and pushed from your machine to this app's project registry (localhost:5050
# for the default project - port 5050, not 5000, to dodge macOS Control Center's claim on 5000 -
# or a project-specific port for another Main project, see docs/architecture.md), but the cluster
# pulls them back using the registry's in-network name. Resolved per app via `localctl app
# registry-info` instead of hardcoded, since a project on its own cluster has its own registry.
registry_info = decode_json(str(local(['localctl', 'app', 'registry-info'], quiet=True)))
default_registry(registry_info['pushHost'], host_from_cluster=registry_info['clusterHost'])

docker_build(
    config_json['name'],
    config_json['build'].get('context', '.'),
    dockerfile=config_json['build'].get('dockerfile', 'Dockerfile'),
    live_update=[
        sync(s['localPath'], s['remotePath'])
        for s in config_json.get('sync', [])
    ],
)

# Manifests are generated by the localctl CLI from .local/config.json so there is a single
# source of truth for the app's k8s definition.
k8s_yaml(local(['localctl', 'app', 'generate-manifests']))

port_forwards = ['%s:%s' % (config_json['port'], config_json['port'])]
debug_cfg = config_json.get('debug', {})
if debug_cfg.get('enabled'):
    dp = debug_cfg['port']
    port_forwards.append('%s:%s' % (dp, dp))

k8s_resource(config_json['name'], port_forwards=port_forwards)
